# This file lists environment variable NAMES only, never real values.
# Copy it to .env and fill in values there. Never commit real secrets.
ANTHROPIC_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave empty locally: Sentry stays off. Set in Vercel only (see README).
VITE_SENTRY_DSN=
# Used by `npm run eval` to sign in as you (the publishable key above is used, so RLS applies).
EVAL_EMAIL=
EVAL_PASSWORD=
